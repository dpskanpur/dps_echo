# ---------------------------------------------------------------
# Database (PostgreSQL)
#
# Local:      run Postgres and point at it directly.
# Cloud Run:  use the Cloud SQL unix socket form, injected from
#             Secret Manager — never commit a real connection string.
#   postgresql://USER:PASSWORD@localhost/dps_echo?host=/cloudsql/PROJECT:REGION:INSTANCE
# ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dps_echo?schema=public"
PORT=8088

# Public base URL of the app (used for OAuth redirects and payment links)
NEXTAUTH_URL="http://localhost:8088"
NEXT_PUBLIC_APP_URL="http://localhost:8088"

# ---------------------------------------------------------------
# Session signing
#
# REQUIRED in production — the app refuses to start without it, because a
# default key would let anyone forge a Super Admin session cookie.
#   openssl rand -hex 32
# ---------------------------------------------------------------
SESSION_SECRET="replace-with-openssl-rand-hex-32"

# ---------------------------------------------------------------
# Google Workspace OAuth 2.0
# Restricts login strictly to accounts on the @dpskanpur.com domain.
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ---------------------------------------------------------------
# Razorpay payment gateway
#
# Without all three set, the public fee page shows dues but disables online
# payment rather than pretending to collect money.
# The webhook secret is set in the Razorpay dashboard against:
#   <NEXT_PUBLIC_APP_URL>/api/payments/webhook   (payment.captured, payment.failed)
# ---------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------
# Notifications (fee reminders, receipts, announcements)
# Unset channels are recorded as SKIPPED instead of being silently dropped.
# ---------------------------------------------------------------
RESEND_API_KEY=""
NOTIFY_EMAIL_FROM="DPS Kanpur <accounts@dpskanpur.com>"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""

# ---------------------------------------------------------------
# Scheduled jobs — shared secret for /api/cron/fee-reminders
#   openssl rand -hex 32
# ---------------------------------------------------------------
CRON_SECRET=""

# ---------------------------------------------------------------
# Service token for /api/v1 (MCP agents, server-to-server)
# Leave empty to disable token auth entirely.
# ---------------------------------------------------------------
ECHO_API_KEY=""
# Optional: pin the service token to a single campus id
ECHO_API_CAMPUS_ID=""

# ---------------------------------------------------------------
# First administrator
#
# admin@dpskanpur.com is always Super Admin. If that mailbox does not exist,
# nominate a real @dpskanpur.com account here so someone can sign in and grant
# access to everyone else — there is no bypass login.
# ---------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=""
